# =====================================================
# .dockerignore - 减少构建上下文大小
# =====================================================

# git
.git/
.gitignore
.gitattributes

# 编辑器
.idea/
.vscode/
*.iml
*.iws
*.ipr
modules.xml
workspace.xml

# 构建产物
bin/
*.exe
*.exe~
go_server
go_server.exe

# 测试覆盖
coverage.out
coverage.html

# 日志
*.log
logs/

# 文档 / 配置(容器内自带 example)
README.md
Makefile
config/config.yaml   # 真实配置不进镜像(容器内走 ENV 注入)

# Docker 自己
Dockerfile
docker-compose.yml
.dockerignore
.dockerignore
.github/

# 敏感配置 / 环境变量(防 .env 进镜像)
.env
.env.*
*.pem
.env.*
